# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# ─── Virtual Environments ────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── IDE / Editor ────────────────────────────────────────
.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace

# ─── OS files ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ─── Jupyter ─────────────────────────────────────────────
.ipynb_checkpoints/
# NOTE: .ipynb files are NOT ignored — they are part of the project

# ─── Large training/data artifacts ───────────────────────
# These CSVs are generated by create_database.py and are NOT
# needed by the running app (app.py only uses Key01.csv & Key02.csv).
# Excluding them keeps the repo fast and under GitHub's size limits.
create_csv/Xtrain.csv
create_csv/Xtest.csv
create_csv/full_data.csv
create_csv/Xor_Key.csv
create_csv/y_train.csv
create_csv/y_test.csv

# ─── Large binary documents ──────────────────────────────
*.docx

# ─── Deployment internals (not for app runtime) ──────────
# Terraform state files contain sensitive resource IDs — never commit these
deployment/terraform/*.tfstate
deployment/terraform/*.tfstate.backup
deployment/terraform/.terraform/
deployment/terraform/.terraform.lock.hcl

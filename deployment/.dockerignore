# Version Control
.git/
.gitignore

# IDE / Editor files
.idea/
.vscode/
*.code-workspace

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# macOS system files
.DS_Store

# Windows system files
Thumbs.db
desktop.ini

# Jupyter Notebooks (not needed at runtime)
*.ipynb
.ipynb_checkpoints/

# Large binary documents (not part of the app)
*.docx
*.pdf
*.zip
*.tar.gz

# Deployment folder itself (Dockerfile etc. not needed inside the image)
deployment/

# Documentation only files
DEVOPS_DEPLOYMENT.md
REBUILD_GUIDE.md
